.DS_Store

# The Tauri sidecar: a ~55MB Mach-O binary rebuilt from ./cmd/gomuks on every
# release (scripts/release.sh). It is a build artifact, not source — committing
# it added 110MB of blobs to this history before it was stripped out.
# The directory itself is kept: `go build -o` does not create missing parents,
# so a fresh clone with no binaries/ would fail the sidecar step.
web/src-tauri/binaries/*
!web/src-tauri/binaries/.gitkeep

# Compiled from icons/echo.icon by scripts/release.sh on every run. actool's output is not
# byte-stable — it changed across two builds of an unchanged .icon — so tracking it would add
# ~1.4MB of new blob per release. The .icon package it is built from IS tracked.
web/src-tauri/icons/Assets.car

